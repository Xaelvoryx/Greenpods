# Environment Configuration Template
# Copy this file to .env and customize as needed. Never commit actual secret keys.

# Runtime Device Selection (cuda or cpu)
DEVICE=cpu

# Random Seed for Deterministic Reproducibility
RANDOM_SEED=42

# Training Hyperparameters
BATCH_SIZE=16
NUM_EPOCHS=15
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=4

# Data Directories
RAW_DATA_DIR=data/raw
OUTPUTS_DIR=outputs
MODELS_DIR=models
